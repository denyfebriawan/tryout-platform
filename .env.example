# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Local PostgreSQL. Create the database first: createdb -U postgres tryout_platform
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tryout_platform?schema=public"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Midtrans (sandbox). Dashboard → Settings → Access Keys, with the environment set to Sandbox.
# The server key is secret; the client key is public (it opens the Snap popup in the browser).
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxx"
# Keep "false" for the demo. "true" switches to production Midtrans (real money).
MIDTRANS_IS_PRODUCTION="false"
# Optional: send webhooks for new transactions here instead of the dashboard's Notification URL,
# e.g. a tunnel to localhost: https://<tunnel>/api/payments/midtrans/notification
MIDTRANS_NOTIFICATION_URL=""
